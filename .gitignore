# Public deliverables stay tracked: source, lockfile, scripts, docs, public/,
# desktop/artwork/, preview/ and reviewed snapshots under docs/evidence/.
# This is a source repository; distribute Windows executables through Releases.

# Downloaded dependencies and reproducible Next / Electron build output.
node_modules/
/.next/
/out/
/build/
/dist/
/coverage/
*.tsbuildinfo
/next-env.d.ts
# prepare-desktop copies this from the tracked public/app.ico.
/desktop/icon.ico

# Local test runs, profiles and diagnostics may contain user metadata.
# Publish reviewed, dated copies in docs/evidence/ instead of unignoring logs/.
/logs/
*.log
*.heapsnapshot
*.heapprofile
*.cpuprofile

# Local configuration, credentials and runtime history are not deliverables.
# Sanitized configuration templates may be shared explicitly.
.env*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
/.model-observatory/
/history.sqlite
/history.sqlite-*
/events.jsonl
/aliases.json
/auth.json

# OS metadata and optional local deployment state.
.DS_Store
Thumbs.db
Desktop.ini
/.vercel/
